# Copy these values into your local environment (do not commit real credentials).
# Aiven PostgreSQL connection string; include Aiven-required SSL options, e.g. ?sslmode=require
DB_URL=jdbc:postgresql://YOUR-AIVEN-HOST:YOUR-PORT/YOUR-DATABASE?sslmode=require
DB_USERNAME=YOUR-AIVEN-USERNAME
DB_PASSWORD=YOUR-AIVEN-PASSWORD

# Frontend origin(s), comma-separated. For local Vite use http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional; defaults to 8080 locally.
PORT=8080
